# Reference values only for non-secret defaults. Secrets NEVER go here.
# AWS credentials live in %USERPROFILE%\.aws\credentials (managed by `aws configure`).
# The CLI does not load .env: pass --profile, --region, --src-bucket and --dst-bucket
# explicitly, or export the S3_RESTORE_* variables below. There are NO bucket defaults:
# omitting both the flags and the env fails with exit code 2. No secrets in env values.

AWS_PROFILE=
AWS_REGION=sa-east-1
S3_RESTORE_SRC_BUCKET=<SRC_BUCKET>
S3_RESTORE_DST_BUCKET=<DST_BUCKET>
